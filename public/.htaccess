# Default document
DirectoryIndex index.html index.php

# Force HTTPS & Canonical URL Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTP to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Enable URL rewriting
Options -MultiViews

# Explicitly do not rewrite direct access to index.html
RewriteRule ^index\.html$ - [L]

# Let real files/directories through
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Allow PHP endpoints under /api to run normally
RewriteRule ^api/.*\.php$ - [L]

# Everything else falls back to SPA index.html
RewriteRule . /index.html [L]

# MIME / charset
AddDefaultCharset UTF-8

# Cache static assets aggressively (safe for CRA build with hashed filenames)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                             "access plus 0 seconds"
  ExpiresByType image/ico                             "access plus 1 year"
  ExpiresByType image/x-icon                          "access plus 1 year"
  ExpiresByType image/webp                            "access plus 1 year"
  ExpiresByType image/jpeg                            "access plus 1 year"
  ExpiresByType image/png                             "access plus 1 year"
  ExpiresByType font/ttf                              "access plus 1 year"
  ExpiresByType font/woff                             "access plus 1 year"
  ExpiresByType font/woff2                            "access plus 1 year"
  ExpiresByType application/javascript                "access plus 1 year"
  ExpiresByType text/css                              "access plus 1 year"
</IfModule>

# Disable directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "(^\.|config\.php$|composer\.(json|lock)$)">
  Require all denied
</FilesMatch>